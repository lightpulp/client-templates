---
import ArmoryLayout from '../../layouts/ArmoryLayout.astro';
import { products, stockLabel, peso, icons, type Product } from '../../data/armory';

export function getStaticPaths() {
  return products.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props as { p: Product };
const related = products.filter((x) => x.category === p.category && x.slug !== p.slug).slice(0, 3);
const holdText = p.stock === 'out' ? 'Sold out. Message us to be told when it is back.' : 'Add it to your list and we will hold it for 3 days once you confirm.';
---
<ArmoryLayout title={`${p.brand} ${p.name} | {brand}`} description={`${p.brand} ${p.name}, ${p.caliber}. ${p.blurb}`}>
  <main class="wrap">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/armory">Inventory</a><span aria-hidden="true">/</span><a href={`/armory?q=${encodeURIComponent(p.category)}`}>{p.category}</a><span aria-hidden="true">/</span><span aria-current="page">{p.name}</span>
    </nav>

    <article class="item">
      <div class="gallery">
        <div class="frame main-shot"><svg viewBox="0 0 64 32" aria-hidden="true" set:html={icons[p.category]} /></div>
        <div class="thumbs" aria-hidden="true">
          <div class="frame"><svg viewBox="0 0 64 32" set:html={icons[p.category]} /></div>
          <div class="frame"><svg viewBox="0 0 64 32" style="transform: scaleX(-1)" set:html={icons[p.category]} /></div>
          <div class="frame"><svg viewBox="0 0 64 32" style="transform: scale(1.4)" set:html={icons[p.category]} /></div>
        </div>
        <p class="photo-note">Product photos go here. We shoot every item in the shop's own lighting.</p>
      </div>

      <div class="info">
        <p class="brandline">{p.brand}</p>
        <h1>{p.name}</h1>
        <p class="sub">{p.category}{p.caliber !== '—' && `, ${p.caliber}`}</p>
        <div class="buy">
          <span class="price">{peso(p.price)}</span>
          <span class={`stock stock-${p.stock}`}>{stockLabel[p.stock]}</span>
        </div>
        <p class="blurb">{p.blurb}</p>
        <button type="button" data-add={p.slug} disabled={p.stock === 'out'} aria-pressed="false">Add to inquiry list</button>
        <p class="hold">{holdText}</p>

        <h2>Specifications</h2>
        <table class="specs">
          <tbody>
            {p.specs.map(([k, v]) => <tr><th scope="row">{k}</th><td>{v}</td></tr>)}
          </tbody>
        </table>

        {['Handguns', 'Rifles', 'Shotguns'].includes(p.category) && (
          <div class="req">
            <h2>What you need to buy this</h2>
            <ul>
              <li>A valid LTOPF in your name</li>
              <li>Two valid government IDs</li>
              <li>Registration is filed by the shop with PNP-FEO before release</li>
            </ul>
          </div>
        )}
      </div>
    </article>

    {related.length > 0 && (
      <section class="related">
        <h2>More {p.category.toLowerCase()}</h2>
        <ul>
          {related.map((r) => (
            <li>
              <a href={`/armory/${r.slug}`}>
                <span class="frame mini"><svg viewBox="0 0 64 32" aria-hidden="true" set:html={icons[r.category]} /></span>
                <span class="r-name">{r.brand} {r.name}</span>
                <span class="r-price">{peso(r.price)}</span>
                <span class={`stock stock-${r.stock}`}>{stockLabel[r.stock]}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </main>

  <style>
    main { padding: 1.5rem 0 4rem; }
    .crumbs { display: flex; gap: 0.5rem; flex-wrap: wrap; color: var(--muted); font-size: 0.92rem; margin-bottom: 1.5rem; }
    .crumbs a { color: var(--muted); }
    .crumbs [aria-current] { color: var(--text); }

    .item { display: grid; grid-template-columns: 1.15fr 1fr; gap: clamp(1.5rem, 4vw, 3.5rem); align-items: start; }
    .main-shot { aspect-ratio: 4 / 3; border: 1px solid var(--edge); }
    .thumbs { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.6rem; margin-top: 0.6rem; }
    .thumbs .frame { border: 1px solid var(--edge); }
    .photo-note { color: var(--muted); font-size: 0.88rem; }

    .brandline { margin: 0; color: var(--muted); }
    h1 { font-size: clamp(2.2rem, 5vw, 3.4rem); }
    .sub { margin: 0.4rem 0 1.25rem; color: var(--muted); }
    .buy { display: flex; align-items: center; gap: 1.25rem; padding: 1rem 0; border-block: 1px solid var(--edge); }
    .price { font: 700 2rem var(--head); color: var(--fde); }
    .blurb { font-size: 1.08rem; max-width: 52ch; }
    .info [data-add] { padding: 0.9rem; font-size: 1.05rem; }
    .hold { color: var(--muted); font-size: 0.9rem; margin: 0.6rem 0 2rem; }
    .info h2 { font-size: 1.25rem; margin-bottom: 0.6rem; }
    .specs { width: 100%; border-collapse: collapse; margin-bottom: 2rem; }
    .specs th, .specs td { text-align: left; padding: 0.55rem 0; border-bottom: 1px solid var(--edge); }
    .specs th { font-weight: 500; color: var(--muted); width: 40%; }
    .req { background: var(--panel); border-left: 3px solid var(--fde); padding: 1rem 1.25rem; }
    .req ul { margin: 0; padding-left: 1.1rem; color: var(--muted); }

    .related { margin-top: 4rem; }
    .related h2 { font-size: 1.6rem; margin-bottom: 1rem; }
    .related ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
    .related a { display: grid; grid-template-columns: 5.5rem 1fr; grid-template-rows: auto auto auto; gap: 0.15rem 0.9rem; align-items: center; padding: 0.75rem; background: var(--panel); border: 1px solid var(--edge); text-decoration: none; }
    .related a:hover { border-color: var(--fde); }
    .mini { grid-row: span 3; }
    .r-name { font-weight: 600; }
    .r-price { font: 700 1.05rem var(--head); color: var(--fde); }

    @media (max-width: 900px) {
      .item, .related ul { grid-template-columns: 1fr; }
    }
  </style>
</ArmoryLayout>
