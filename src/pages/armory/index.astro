---
import ArmoryLayout from '../../layouts/ArmoryLayout.astro';
import { products, categories, stockLabel, peso, icons, brand } from '../../data/armory';

const calibers = [...new Set(products.map((p) => p.caliber).filter((c) => c !== '—'))];
const brands = [...new Set(products.map((p) => p.brand))].sort();
const countIn = (cat: string) => products.filter((p) => p.category === cat).length;
const groups = [
  { key: 'category', label: 'Type', values: [...categories] },
  { key: 'caliber', label: 'Caliber', values: calibers },
  { key: 'brand', label: 'Brand', values: brands },
];
---
<ArmoryLayout title="{brand} | Firearms, optics and gear in Pampanga" description={`In-store inventory at ${brand.name}: handguns, rifles, shotguns, optics and gear.`}>
  <main>
    <section class="intro wrap">
      <div>
        <h1>What's on the shelf today</h1>
        <p>The shop updates this list every morning. Add what you're after to your inquiry list and we'll confirm price and stock before you drive over.</p>
      </div>
      <ul class="cats" aria-label="Shop by type">
        {categories.map((c) => (
          <li><button type="button" class="cat" data-cat={c}><span>{c}</span><span class="cat-n">{countIn(c)}</span></button></li>
        ))}
      </ul>
    </section>

    <section id="inventory" class="catalog wrap">
      <details class="filters" id="filters" open>
        <summary>Filters</summary>
        <div class="filter-body">
          <label class="toggle"><input type="checkbox" id="instock" /> Hide sold out</label>
          {groups.map((g) => (
            <fieldset>
              <legend>{g.label}</legend>
              {g.values.map((v) => (
                <label class="opt"><input type="checkbox" data-group={g.key} value={v} /> {v}</label>
              ))}
            </fieldset>
          ))}
          <button type="button" class="clear" id="clear">Clear filters</button>
        </div>
      </details>

      <div class="results">
        <div class="toolbar">
          <p id="showing" aria-live="polite">Showing {products.length} items</p>
          <label>Sort by
            <select id="sort">
              <option value="featured">Featured first</option>
              <option value="low">Price, low to high</option>
              <option value="high">Price, high to low</option>
              <option value="name">Name</option>
            </select>
          </label>
        </div>
        <ul class="grid" id="grid">
          {products.map((p, i) => (
            <li class="card" data-category={p.category} data-caliber={p.caliber} data-brand={p.brand} data-price={p.price} data-stock={p.stock} data-order={p.featured ? i - 100 : i} data-text={`${p.brand} ${p.name} ${p.caliber} ${p.category}`.toLowerCase()}>
              <a class="frame" href={`/armory/${p.slug}`} aria-label={`${p.brand} ${p.name} details`}>
                <svg viewBox="0 0 64 32" aria-hidden="true" set:html={icons[p.category]} />
              </a>
              <div class="card-body">
                <p class="card-brand">{p.brand}</p>
                <h2 class="card-name"><a href={`/armory/${p.slug}`}>{p.name}</a></h2>
                <p class="card-meta">{p.category}{p.caliber !== '—' && `, ${p.caliber}`}</p>
                <div class="card-row">
                  <span class="price">{peso(p.price)}</span>
                  <span class={`stock stock-${p.stock}`}>{stockLabel[p.stock]}</span>
                </div>
                <button type="button" data-add={p.slug} disabled={p.stock === 'out'} aria-pressed="false">Add to inquiry list</button>
              </div>
            </li>
          ))}
        </ul>
        <p class="none" id="none" hidden>Nothing matches those filters. Clear a filter or search a different model.</p>
      </div>
    </section>

    <section id="services" class="services">
      <div class="wrap">
        <h2>Beyond the counter</h2>
        <div class="svc-grid">
          <div><h3>License and permit help</h3><p>We walk first-time owners through the LTOPF, firearm registration and permit to carry, and tell you exactly what to bring.</p></div>
          <div><h3>Gunsmithing and cleaning</h3><p>Deep cleaning, sight and optic installs, trigger work and function checks by our in-house gunsmith.</p></div>
          <div><h3>Trade-ins</h3><p>Bring your registered firearm for an appraisal. We buy, trade or sell on consignment.</p></div>
        </div>

        <h2 class="how-h">How buying a firearm works</h2>
        <ol class="how">
          <li><h3>Inquire</h3><p>Send your list. We confirm price and hold the item for 3 days.</p></li>
          <li><h3>Visit</h3><p>Bring a valid ID and your LTOPF. We check your documents in store.</p></li>
          <li><h3>Paperwork</h3><p>We file the registration with PNP-FEO for you.</p></li>
          <li><h3>Release</h3><p>Your firearm is released once the registration is approved.</p></li>
        </ol>
      </div>
    </section>
  </main>

  <script>
    const cards = [...document.querySelectorAll<HTMLElement>('.card')];
    const grid = document.getElementById('grid')!;
    const boxes = [...document.querySelectorAll<HTMLInputElement>('[data-group]')];
    const instock = document.getElementById('instock') as HTMLInputElement;
    const search = document.getElementById('q') as HTMLInputElement;
    const sort = document.getElementById('sort') as HTMLSelectElement;
    const showing = document.getElementById('showing')!;
    const none = document.getElementById('none')!;

    if (matchMedia('(max-width: 900px)').matches) document.getElementById('filters')!.removeAttribute('open');
    search.value = new URLSearchParams(location.search).get('q') ?? '';

    function apply() {
      const picked: Record<string, string[]> = {};
      boxes.filter((b) => b.checked).forEach((b) => (picked[b.dataset.group!] ??= []).push(b.value));
      const q = search.value.trim().toLowerCase();
      let shown = 0;
      cards.forEach((c) => {
        const ok =
          Object.entries(picked).every(([g, vals]) => vals.includes(c.dataset[g]!)) &&
          (!instock.checked || c.dataset.stock !== 'out') &&
          (!q || q.split(/\s+/).every((w) => c.dataset.text!.includes(w)));
        c.hidden = !ok;
        if (ok) shown++;
      });
      showing.textContent = `Showing ${shown} of ${cards.length} items`;
      none.hidden = shown > 0;
      document.querySelectorAll<HTMLButtonElement>('.cat').forEach((b) => {
        b.setAttribute('aria-pressed', String((picked.category ?? []).length === 1 && picked.category[0] === b.dataset.cat));
      });
    }

    function order() {
      const by: Record<string, (a: HTMLElement, b: HTMLElement) => number> = {
        featured: (a, b) => Number(a.dataset.order) - Number(b.dataset.order),
        low: (a, b) => Number(a.dataset.price) - Number(b.dataset.price),
        high: (a, b) => Number(b.dataset.price) - Number(a.dataset.price),
        name: (a, b) => a.dataset.text!.localeCompare(b.dataset.text!),
      };
      [...cards].sort(by[sort.value]).forEach((c) => grid.append(c));
    }

    document.querySelectorAll<HTMLButtonElement>('.cat').forEach((b) =>
      b.addEventListener('click', () => {
        const on = b.getAttribute('aria-pressed') === 'true';
        boxes.filter((x) => x.dataset.group === 'category').forEach((x) => (x.checked = !on && x.value === b.dataset.cat));
        apply();
        document.getElementById('inventory')!.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
      })
    );
    document.getElementById('clear')!.addEventListener('click', () => {
      boxes.forEach((b) => (b.checked = false));
      instock.checked = false;
      search.value = '';
      apply();
    });
    [...boxes, instock].forEach((b) => b.addEventListener('change', apply));
    search.addEventListener('input', apply);
    search.form!.addEventListener('submit', (e) => { e.preventDefault(); apply(); document.getElementById('inventory')!.scrollIntoView(); });
    sort.addEventListener('change', order);
    order();
    apply();
  </script>

  <style>
    .intro { display: grid; grid-template-columns: 1fr 1.25fr; gap: 2.5rem; align-items: end; padding: clamp(2.5rem, 6vw, 4.5rem) 0 2.5rem; }
    .intro h1 { font-size: clamp(2.4rem, 5.5vw, 4.2rem); letter-spacing: -0.01em; max-width: 11ch; }
    .intro p { color: var(--muted); max-width: 48ch; margin: 1.1rem 0 0; font-size: 1.08rem; }
    .cats { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1px; background: var(--edge); border: 1px solid var(--edge); }
    .cat { display: flex; justify-content: space-between; align-items: baseline; width: 100%; padding: 1.1rem 1rem; background: var(--panel); color: var(--text); border: 0; font: 600 1.05rem/1.1 var(--head); text-align: left; cursor: pointer; }
    .cat:hover { background: var(--raised); }
    .cat[aria-pressed='true'] { background: var(--fde); color: #23292c; }
    .cat-n { font-size: 0.85rem; color: var(--muted); }
    .cat[aria-pressed='true'] .cat-n { color: #3b3426; }

    .catalog { display: grid; grid-template-columns: 15rem minmax(0, 1fr); gap: 2rem; align-items: start; padding-bottom: 4rem; scroll-margin-top: 5rem; }
    .filters { position: sticky; top: 5.5rem; background: var(--panel); border: 1px solid var(--edge); }
    .filters summary { padding: 0.85rem 1rem; font: 600 1.05rem var(--head); cursor: pointer; border-bottom: 1px solid var(--edge); }
    .filter-body { padding: 1rem; display: grid; gap: 1.1rem; max-height: calc(100vh - 11rem); overflow: auto; }
    fieldset { border: 0; margin: 0; padding: 0; display: grid; gap: 0.35rem; }
    legend { font: 600 0.95rem var(--head); color: var(--fde); margin-bottom: 0.35rem; }
    .opt, .toggle { display: flex; gap: 0.5rem; align-items: center; font-size: 0.95rem; cursor: pointer; }
    input[type='checkbox'] { accent-color: var(--fde); width: 1rem; height: 1rem; }
    .clear { background: none; border: 0; color: var(--muted); text-decoration: underline; cursor: pointer; font: inherit; justify-self: start; padding: 0; }

    .toolbar { display: flex; justify-content: space-between; align-items: center; gap: 1rem; margin-bottom: 1rem; color: var(--muted); }
    .toolbar p { margin: 0; }
    .toolbar select { font: inherit; color: var(--text); background: var(--panel); border: 1px solid var(--edge); padding: 0.4rem 0.5rem; margin-left: 0.4rem; }
    .grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(14.5rem, 1fr)); gap: 1rem; }
    .card { background: var(--panel); border: 1px solid var(--edge); display: flex; flex-direction: column; }
    .card[hidden] { display: none; }
    .card-body { padding: 0.9rem 1rem 1rem; display: flex; flex-direction: column; gap: 0.2rem; flex: 1; }
    .card-brand { margin: 0; color: var(--muted); font-size: 0.85rem; }
    .card-name { font-size: 1.2rem; }
    .card-name a { text-decoration: none; }
    .card-name a:hover { color: var(--fde); }
    .card-meta { margin: 0; color: var(--muted); font-size: 0.9rem; }
    .card-row { display: flex; justify-content: space-between; align-items: center; margin: auto 0 0.7rem; padding-top: 0.6rem; }
    .price { font: 700 1.3rem var(--head); color: var(--fde); }
    .none { padding: 2rem; border: 1px dashed var(--edge); color: var(--muted); }

    .services { background: var(--panel); border-top: 1px solid var(--edge); padding: clamp(3rem, 7vw, 5rem) 0; }
    .services h2 { font-size: clamp(1.9rem, 4vw, 2.8rem); margin-bottom: 1.75rem; }
    .svc-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2rem; }
    .svc-grid h3 { font-size: 1.25rem; color: var(--fde); margin-bottom: 0.5rem; }
    .svc-grid p { margin: 0; color: var(--muted); }
    .how-h { margin-top: 3.5rem; }
    .how { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); counter-reset: s; border-top: 1px solid var(--edge); }
    .how li { counter-increment: s; padding: 1.25rem 1.25rem 0 0; position: relative; }
    .how li::before { content: counter(s); display: grid; place-items: center; width: 2.1rem; height: 2.1rem; border: 2px solid var(--fde); color: var(--fde); font: 700 1rem var(--head); margin-bottom: 0.9rem; }
    .how h3 { font-size: 1.15rem; margin-bottom: 0.35rem; }
    .how p { margin: 0; color: var(--muted); }

    @media (max-width: 900px) {
      .intro, .catalog { grid-template-columns: 1fr; }
      .filters { position: static; }
      .filter-body { max-height: none; }
      .cats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .svc-grid, .how { grid-template-columns: 1fr; }
    }
  </style>
</ArmoryLayout>
